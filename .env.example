# =============================================================================
# ML KRAKEN PRO LIVE TRADER - CONFIGURATION FILE
# =============================================================================
# This file contains all configuration parameters for the trading system.
# Copy this file to .env and fill in your actual values.
# NEVER commit .env with real API keys to version control!
# =============================================================================

# =============================================================================
# TRADING CONFIGURATION
# =============================================================================

# Trading Mode (MUST BE 1 FOR LIVE TRADING)
LIVE_TRADING=1

# Portfolio Configuration
PORTFOLIO_SIZE_USD=500
RISK_MODE=balanced  # Options: conservative, balanced, aggressive

# =============================================================================
# KRAKEN API KEYS (5 KEYS REQUIRED)
# =============================================================================
# You MUST provide 5 separate Kraken API key pairs for optimal performance
# Get your keys from: https://www.kraken.com/u/security/api

KRAKEN_KEY_1=YOUR_API_KEY_1_HERE
KRAKEN_SECRET_1=YOUR_API_SECRET_1_HERE

KRAKEN_KEY_2=YOUR_API_KEY_2_HERE
KRAKEN_SECRET_2=YOUR_API_SECRET_2_HERE

KRAKEN_KEY_3=YOUR_API_KEY_3_HERE
KRAKEN_SECRET_3=YOUR_API_SECRET_3_HERE

KRAKEN_KEY_4=YOUR_API_KEY_4_HERE
KRAKEN_SECRET_4=YOUR_API_SECRET_4_HERE

KRAKEN_KEY_5=YOUR_API_KEY_5_HERE
KRAKEN_SECRET_5=YOUR_API_SECRET_5_HERE

# =============================================================================
# UNIVERSE CONFIGURATION
# =============================================================================

# Base currency (always USD for US traders)
BASE_QUOTE=USD

# Number of pairs to trade (Top N by volume)
UNIVERSE_SIZE=10

# How often to refresh universe (minutes)
UNIVERSE_REFRESH_MINUTES=60

# Minimum 24h volume for pair inclusion (USD)
MIN_DAILY_VOLUME_USD=1000000

# =============================================================================
# RISK MANAGEMENT PARAMETERS
# =============================================================================

# Position Sizing
MAX_POSITION_PCT=3           # Max % of portfolio per single trade
MAX_DAILY_VOLUME_PCT=15      # Max % of portfolio traded per day
MAX_CONCURRENT_POSITIONS=5   # Maximum number of open positions

# Drawdown Protection
MAX_DAILY_DRAWDOWN_PCT=10    # Daily circuit breaker threshold
MAX_WEEKLY_DRAWDOWN_PCT=20   # Weekly circuit breaker threshold

# Fee Optimization
EDGE_BUFFER_BPS=20           # Minimum edge required (0.2% = 20 basis points)
FEE_MULTIPLIER=3             # Expected profit must exceed fees by this factor

# Position Concentration
MAX_SINGLE_ASSET_PCT=25      # Max % of portfolio in any single asset

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================

# Latency & Timing
MAX_DECISION_LATENCY_MS=100         # Model prediction timeout
ORDER_TIMEOUT_SECONDS=30            # Maker order timeout before cancel
FEATURE_LOOKBACK_SECONDS=300        # Feature computation window (5 minutes)
WEBSOCKET_HEARTBEAT_TIMEOUT=30      # WebSocket connection timeout

# Data & Features
FEATURE_CACHE_SIZE_MB=512           # Memory cache for computed features
DATA_RETENTION_DAYS=90              # How long to keep raw tick data

# =============================================================================
# MODEL CONFIGURATION
# =============================================================================

# Model Training
MODEL_RETRAIN_HOURS=24              # How often to retrain models
TRAINING_WINDOW_DAYS=30             # Training data window
VALIDATION_DAYS=1                   # Validation period
MIN_TRAINING_SAMPLES=10000          # Minimum samples required for training

# Prediction
CONFIDENCE_THRESHOLD=0.65           # Minimum confidence to trade (conservative)
CONFIDENCE_THRESHOLD_AGGRESSIVE=0.55 # Minimum confidence (aggressive mode)
ENSEMBLE_MODELS=true                # Use XGBoost + LightGBM ensemble

# Feature Engineering
ENABLE_CROSS_ASSET_FEATURES=true    # Compute correlation features
ENABLE_TEMPORAL_FEATURES=true       # Time-of-day features
ENABLE_VOLATILITY_REGIMES=true      # Volatility regime detection

# =============================================================================
# SYSTEM CONFIGURATION
# =============================================================================

# Logging
LOG_LEVEL=INFO                      # Options: DEBUG, INFO, WARN, ERROR
LOG_RETENTION_DAYS=30               # How long to keep log files
ENABLE_TRADE_LOGGING=true           # Log every trade decision

# Monitoring Ports
METRICS_PORT=8080                   # Prometheus metrics endpoint
HEALTH_CHECK_PORT=8081              # Health check HTTP endpoint

# =============================================================================
# EMERGENCY CONTROLS
# =============================================================================

# Kill Switch
KILL_SWITCH_PASSWORD=CHANGE_THIS_PASSWORD_NOW  # Emergency stop password
CIRCUIT_BREAKER_COOLDOWN_MINUTES=60            # Cooldown after circuit breaker
MAX_CONSECUTIVE_LOSSES=5                        # Trigger cooldown after N losses

# Safety Features
ENABLE_CIRCUIT_BREAKERS=true        # Enable automatic trading halts
ENABLE_SPREAD_PROTECTION=true       # Halt on abnormal spreads
SPREAD_PERCENTILE_THRESHOLD=95      # Spread percentile for halt
ENABLE_LATENCY_PROTECTION=true      # Halt on high latency
MAX_API_LATENCY_MS=500              # Maximum acceptable API latency

# =============================================================================
# ADVANCED SETTINGS (MODIFY WITH CAUTION)
# =============================================================================

# Order Execution
MAKER_ORDER_PRICE_IMPROVEMENT_BPS=1  # Price improvement for limit orders
ICEBERG_THRESHOLD_USD=100            # Use iceberg orders above this size
ORDER_SIZE_RANDOMIZATION_PCT=5       # Randomize order sizes within this range

# Rate Limiting
REQUESTS_PER_KEY_PER_SECOND=1        # Rate limit per API key
RATE_LIMIT_COOLDOWN_SECONDS=10       # Cooldown after rate limit hit

# Market Data
ORDERBOOK_DEPTH_LEVELS=10            # Number of order book levels to track
TICK_DATA_BUFFER_SIZE=10000          # Number of ticks to keep in memory

# Model Performance
MIN_SHARPE_RATIO=0.5                 # Minimum Sharpe for model deployment
MIN_MODEL_ACCURACY=0.55              # Minimum accuracy for model deployment
MODEL_DRIFT_THRESHOLD=0.1            # Trigger retraining if accuracy drops by this

# Compliance
ENABLE_ASSET_RESTRICTIONS=true       # Enforce NC restricted assets list
ENABLE_AUDIT_LOGGING=true            # Log all decisions for compliance
AUDIT_LOG_RETENTION_DAYS=365         # How long to keep audit logs

# =============================================================================
# END OF CONFIGURATION
# =============================================================================
